ANCHOR_API_KEY=
ANCHOR_API_BASE=https://api.anchorbrowser.io/v1

# Slack: bot token + channel for interactive drafts, signing secret for button callbacks.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=

# Bearer token for POST /discover and POST /publish.
INTERNAL_API_TOKEN=
PORT=8787

# Anchor applications are resolved by name/URL; set IDs to pin them.
GAUGE_APPLICATION_ID=
GAUGE_APPLICATION_NAME=Gauge
GAUGE_APPLICATION_URL=https://app.withgauge.com
GAUGE_IDENTITY_ID=
SEARCH_CONSOLE_APPLICATION_ID=
SEARCH_CONSOLE_APPLICATION_NAME=Google Search Console
SEARCH_CONSOLE_APPLICATION_URL=https://search.google.com/search-console
SEARCH_CONSOLE_IDENTITY_ID=

# Thumbnails: openai or gemini (auto-detected from the key that is set).
THUMBNAIL_PROVIDER=
THUMBNAIL_MODEL=
THUMBNAIL_TIMEOUT_MS=180000
THUMBNAIL_OUTPUT_DIR=state/thumbnails
THUMBNAIL_REFERENCE_IMAGE=assets/thumbnail-reference.png
AUTO_PUBLISH_DELAY_MS=900000
OPENAI_API_KEY=
GEMINI_API_KEY=

PUBLISH_AUTHOR=Idan Raman
IDENTITY_USER_NAME=
REAUTH_AUTH_METHOD=profile
NOTIFY_RECOVERY=true
REQUEST_TIMEOUT_MS=20000
ANCHOR_REAUTH_TIMEOUT_MS=900000
ANCHOR_CONTENT_TASK_TIMEOUT_MS=1800000
ANCHOR_TASK_POLL_INTERVAL_MS=3000
NODE_STATE_FILE=state/identity-monitor.json
NODE_DRAFT_FILE=state/discovery-drafts.json
RUN_INTERVAL_MS=172800000
PUBLIC_HOSTNAME=
