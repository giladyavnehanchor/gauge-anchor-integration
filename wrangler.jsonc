{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anchor-identity-monitor",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["0 3 */2 * *"]
  },
  "kv_namespaces": [
    {
      "binding": "IDENTITY_MONITOR_STATE",
      "id": "replace-with-production-kv-namespace-id",
      "preview_id": "replace-with-preview-kv-namespace-id"
    }
  ],
  "vars": {
    "ANCHOR_API_BASE": "https://api.anchorbrowser.io/v1",
    "GAUGE_APPLICATION_NAME": "Gauge",
    "GAUGE_APPLICATION_URL": "https://app.withgauge.com",
    "GAUGE_CONTENT_TASK_NAME": "gauge-content-research-outline",
    "GAUGE_PUBLISH_TASK_NAME": "gauge-publish-article-from-todo",
    "SEARCH_CONSOLE_INDEX_TASK_NAME": "search-console-request-indexing",
    "THUMBNAIL_PROVIDER": "openai",
    "THUMBNAIL_MODEL": "gpt-image-1",
    "THUMBNAIL_TIMEOUT_MS": "180000",
    "SEARCH_CONSOLE_APPLICATION_NAME": "Google Search Console",
    "SEARCH_CONSOLE_APPLICATION_URL": "https://search.google.com/search-console",
    "NOTIFY_RECOVERY": "true",
    "DRY_RUN": "false",
    "ANCHOR_REAUTH_TIMEOUT_MS": "900000",
    "ANCHOR_TASK_POLL_INTERVAL_MS": "3000",
    "ANCHOR_CONTENT_TASK_TIMEOUT_MS": "1800000",
    "GAUGE_VALIDATION_TASK_NAME": "anchor-identity-monitor-gauge-dom-check",
    "SEARCH_CONSOLE_VALIDATION_TASK_NAME": "anchor-identity-monitor-search-console-dom-check"
  }
}
